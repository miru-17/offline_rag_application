# RAGENTIS - Docker Compose environment template
# Copy to `.env` in the project root and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# Password for the PostgreSQL 'postgres' user (used by the postgres
# container and passed to the backend as PGPASSWORD).
POSTGRES_PASSWORD=change-me

# Long random string used to sign JWT access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
