# RAGENTIS - Docker Compose environment template
# Copy to `.env` in the project root and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# Password for the PostgreSQL 'postgres' user (used by the postgres
# container and passed to the backend as PGPASSWORD).
POSTGRES_PASSWORD=change-me

# Long random string (AT LEAST 32 characters) used to sign JWT access tokens.
# The backend refuses to start if it is missing or shorter.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Optional
OLLAMA_MODEL=llama3.2:3b
# First account becomes ADMIN; after that admins add users. Set true to allow public sign-up.
ALLOW_SELF_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=false
