# RAGENTIS - settings for docker compose.
# Copy to `.env` in this folder and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------- required
# Password for the PostgreSQL 'postgres' user. Keep your CURRENT password on
# an existing installation - the database was created with it.
POSTGRES_PASSWORD=change-me

# Long random string (AT LEAST 32 characters) that signs sign-in tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Key that encrypts two-step-login secrets in the database. Recommended.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up: if it is lost, users must set up two-step login again.
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- web address
# Names / addresses people type in the browser (space separated).
RAGENTIS_HOSTS=localhost 127.0.0.1
# 127.0.0.1 = only this computer; 0.0.0.0 = whole office network.
RAGENTIS_BIND=127.0.0.1
RAGENTIS_HTTPS_PORT=8443
RAGENTIS_HTTP_PORT=8080
# "internal" (built-in certificate authority) or your company certificate,
# copied into ./certs:  RAGENTIS_TLS=/certs/cert.pem /certs/key.pem
RAGENTIS_TLS=internal

# ---------------------------------------------------------------- AI
OLLAMA_MODEL=llama3.2:3b
# Keep the model in memory between questions (first answer after a pause is much faster).
OLLAMA_KEEP_ALIVE=30m
# Extra models an admin may choose in Settings (must be pulled into Ollama).
OLLAMA_ALLOWED_MODELS=
# For Tamil/Hindi/other languages: paraphrase-multilingual-MiniLM-L12-v2
# (then Settings -> Re-index documents).
EMBEDDING_MODEL=all-MiniLM-L6-v2
HYBRID_SEARCH=true
# OCR languages for scanned files: eng, eng+tam, eng+tam+hin
OCR_LANGUAGES=eng

# ---------------------------------------------------------------- watched folder
# Files copied into this folder are added automatically.
RAGENTIS_WATCH_DIR=./watch
# Account that owns those files (default: first administrator).
WATCH_OWNER=

# ---------------------------------------------------------------- Active Directory / LDAP (optional)
LDAP_ENABLED=false
# ldaps://dc01.corp.local:636
LDAP_SERVER_URL=
# {username}@corp.local   or   CORP\{username}
LDAP_BIND_TEMPLATE=
# DC=corp,DC=local
LDAP_SEARCH_BASE=
LDAP_USER_FILTER=(sAMAccountName={username})
# Group DN=ROLE pairs separated by ";"
# CN=RAG-Admins,OU=Groups,DC=corp,DC=local=ADMIN;CN=RAG-Users,OU=Groups,DC=corp,DC=local=USER
LDAP_GROUP_ROLE_MAP=
LDAP_DEFAULT_ROLE=VIEWER

# ---------------------------------------------------------------- other
# First account becomes ADMIN; after that admins add users.
ALLOW_SELF_REGISTRATION=false
# Only needed for the developer front end (npm run dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=false
# Lock a local account after this many wrong passwords / codes, for this many minutes.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
