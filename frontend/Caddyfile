# RAGENTIS web server: serves the app and forwards /api to the backend.
#
# RAGENTIS_HOSTS  names/addresses people type in the browser, separated by
#                 spaces, e.g. "localhost 127.0.0.1 192.168.1.20 ragentis.local"
# RAGENTIS_TLS    "internal"  -> certificates from Caddy's own local authority
#                               (install its root certificate on office PCs once,
#                                see the admin guide), or
#                 "/certs/cert.pem /certs/key.pem" -> your company certificate.
{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://:80 {
	redir https://{host}:{$RAGENTIS_HTTPS_PORT:8443}{uri} permanent
}

{$RAGENTIS_HOSTS:localhost 127.0.0.1} {
	tls {$RAGENTIS_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle_path /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy backend:8000 {
			# Stream answers word by word (Server-Sent Events).
			flush_interval -1
			transport http {
				read_timeout 15m
			}
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
